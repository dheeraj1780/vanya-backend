# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./plant_companion.db

# ── Session JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# ── Firebase Authentication ─────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=./secrets/firebase_service_account.json

# ── Billing — Razorpay Subscriptions (sold on the VANYA website, NOT ──────
# inside the Flutter app — see billing_service.py's module docstring) ────
# Dashboard > Account & Settings > API Keys.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard > Account & Settings > Webhooks > Secret — Razorpay signs every
# webhook body with this (HMAC-SHA256), verified in razorpay_client.py.
RAZORPAY_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── AI Vision provider ─────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-3.5-flash-lite

# ── Photo storage ──────────────────────────────────────────────────────────
# "local" for dev only (see storage.py's module docstring — ephemeral on
# most production hosts). Production should use "s3" instead:
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8000
# S3-compatible storage (Cloudflare R2 / AWS S3 / Backblaze B2 / DO
# Spaces) — only read when STORAGE_BACKEND=s3.
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=vanya-photos
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_REGION=auto
# S3_PUBLIC_URL_BASE=https://photos.your-domain.com

# ── Rate limiting ──────────────────────────────────────────────────────────
AI_DAILY_CALL_LIMIT=10

# ── CORS — includes the VANYA website's dev origin (Vite default port) ────
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost
